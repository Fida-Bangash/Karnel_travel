@model Karnel_Travel.Models.TouristSpot

@{
    ViewData["Title"] = "Tourist Spot Details";
}

<!-- Page heading -->
<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle"><i class="bi bi-geo-alt-fill"></i> @Model.Location</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn-crud btn-crud-light"><i class="bi bi-arrow-left"></i> Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-crud btn-crud-primary"><i class="bi bi-pencil-square"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-crud btn-crud-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>

<div class="row g-4">
    <!-- Image -->
    <div class="col-lg-5">
        <div class="crud-card">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="detail-hero" alt="@Model.Name" />
            }
            else
            {
                <div class="detail-hero-empty"><i class="bi bi-image"></i> No image uploaded</div>
            }
        </div>
    </div>

    <!-- Information -->
    <div class="col-lg-7">
        <div class="crud-card">
            <div class="crud-card-title"><i class="bi bi-info-circle"></i> Information</div>

            <div class="detail-row">
                <div class="k">Name</div>
                <div class="v">@Model.Name</div>
            </div>
            <div class="detail-row">
                <div class="k">Category</div>
                <div class="v"><span class="tag-pill">@Model.Category</span></div>
            </div>
            <div class="detail-row">
                <div class="k">Location</div>
                <div class="v">@Model.Location</div>
            </div>
            <div class="detail-row">
                <div class="k">Description</div>
                <div class="v">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description added." : Model.Description)</div>
            </div>
        </div>
    </div>
</div>
