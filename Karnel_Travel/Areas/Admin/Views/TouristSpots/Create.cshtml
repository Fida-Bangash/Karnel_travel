@model Karnel_Travel.Models.TouristSpot

@{
    ViewData["Title"] = "Add Tourist Spot";
}

<!-- Page heading -->
<div class="page-header">
    <div>
        <h1 class="page-title">Add Tourist Spot</h1>
        <p class="page-subtitle">Fill in the details below. This will appear on the website.</p>
    </div>
    <a asp-action="Index" class="btn-crud btn-crud-light"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<form asp-action="Create" enctype="multipart/form-data" novalidate>
    <div class="row g-4">

        <!-- Left: text details -->
        <div class="col-lg-8">
            <div class="crud-card">
                <div class="crud-card-title"><i class="bi bi-geo-alt"></i> Spot Details</div>

                <div asp-validation-summary="ModelOnly" class="crud-summary"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Name" class="crud-label">Spot Name <span class="req">*</span></label>
                        <input asp-for="Name" class="crud-input" placeholder="e.g. Clifton Beach" maxlength="100" />
                        <span asp-validation-for="Name" class="crud-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category" class="crud-label">Category <span class="req">*</span></label>
                        <input asp-for="Category" class="crud-input" list="categoryList" placeholder="e.g. Beach" maxlength="50" />
                        <datalist id="categoryList">
                            <option value="Beach"></option>
                            <option value="Monument"></option>
                            <option value="Historical"></option>
                            <option value="Mountain"></option>
                            <option value="Park"></option>
                            <option value="Museum"></option>
                            <option value="Lake"></option>
                            <option value="Waterfall"></option>
                            <option value="Religious"></option>
                        </datalist>
                        <div class="crud-help">Pick a suggestion or type your own.</div>
                        <span asp-validation-for="Category" class="crud-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Location" class="crud-label">Location <span class="req">*</span></label>
                        <input asp-for="Location" class="crud-input" placeholder="e.g. Karachi, Sindh" maxlength="100" />
                        <span asp-validation-for="Location" class="crud-error"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="crud-label">Description</label>
                        <textarea asp-for="Description" class="crud-textarea" rows="6" maxlength="1000"
                                  placeholder="Write a short description about this place..."
                                  data-counter="descCount"></textarea>
                        <div class="crud-counter" id="descCount">0 / 1000</div>
                        <span asp-validation-for="Description" class="crud-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: image upload -->
        <div class="col-lg-4">
            <div class="crud-card">
                <div class="crud-card-title"><i class="bi bi-image"></i> Spot Image</div>

                <div class="upload-box">
                    <img id="imgPreview" class="upload-preview" alt="Preview" />
                    <div id="imgPlaceholder" class="upload-placeholder">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <strong>Click or drag an image here</strong>
                    </div>
                    <div id="imgName" class="upload-name"></div>
                    <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp"
                           data-preview="imgPreview" data-name="imgName"
                           data-placeholder="imgPlaceholder" data-error="imgError" />
                </div>
                <div class="upload-hint mt-2">JPG, PNG or WEBP. Maximum 2 MB.</div>
                <span id="imgError" class="crud-error"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn-crud btn-crud-primary justify-content-center">
                    <i class="bi bi-check-lg"></i> Create Spot
                </button>
                <a asp-action="Index" class="btn-crud btn-crud-light justify-content-center">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/admin/js/crud-form.js"></script>
}
