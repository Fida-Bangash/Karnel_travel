@* Model bound to this view. *@
@model Karnel_Travel.Models.ContactMessage

@* Page setup: title and helper variables. *@
@{
    ViewData["Title"] = "Delete Message";
}

<!-- Page heading -->
<div class="page-header">
    <div>
        <h1 class="page-title">Delete Message</h1>
        <p class="page-subtitle">Please confirm before removing this item.</p>
    </div>
</div>

@* Delete confirmation layout. *@
<div class="row">
    <div class="col-lg-7 col-xl-6">
        @* Delete confirmation card. *@
        <div class="crud-card delete-card">

            <span class="delete-icon"><i class="bi bi-exclamation-triangle"></i></span>
            <h4 class="fw-bold mb-1">Are you sure you want to delete this message?</h4>
            <p class="text-muted mb-4">The customer's message will be permanently removed. This action cannot be undone.</p>

            <!-- Summary of the item being deleted -->
            <div class="table-user-cell p-3 mb-4" style="background:#F8FAF9;border-radius:var(--radius-lg)">
                <span class="avatar-initial">@(string.IsNullOrWhiteSpace(Model.Name) ? "?" : Model.Name.Trim().Substring(0, 1))</span>
                <div>
                    <div class="table-user-name">@Model.Name</div>
                    <div class="table-user-sub">@Model.Email &bull; @Model.Subject</div>
                </div>
            </div>

            @* Posts to DeleteConfirmed after the admin confirms. *@
            <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
                @* Keeps the record id on submit. *@
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-crud btn-crud-danger"><i class="bi bi-trash"></i> Yes, Delete</button>
                <a asp-action="Index" class="btn-crud btn-crud-light">Cancel</a>
            </form>
        </div>
    </div>
</div>
