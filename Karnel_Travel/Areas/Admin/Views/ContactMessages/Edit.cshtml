@* Model bound to this view. *@
@model Karnel_Travel.Models.ContactMessage

@* Page setup: title and helper variables. *@
@{
    ViewData["Title"] = "Edit Message";
    var m = Model ?? new Karnel_Travel.Models.ContactMessage();
}

<!-- Page heading -->
<div class="page-header">
    <div>
        <h1 class="page-title">Edit Message</h1>
        <p class="page-subtitle">Update the details of <strong>@Model.Name</strong>.</p>
    </div>
    <a asp-action="Index" class="btn-crud btn-crud-light"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

@* Form posted to the server. *@
<form asp-action="Edit" novalidate>
    @* Keeps the record id on submit. *@
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedOn" />
    @* Two-column page layout. *@
    <div class="row g-4">

        <!-- Left: details -->
        <div class="col-lg-8">
            @* Card: Sender. *@
            <div class="crud-card">
                <div class="crud-card-title"><i class="bi bi-person"></i> Sender</div>

                @* Model-level validation errors. *@
                <div asp-validation-summary="ModelOnly" class="crud-summary"></div>

                @* Form fields grid. *@
                <div class="row g-3">
                    @* Field: Name. *@
                    <div class="col-md-6">
                        <label asp-for="Name" class="crud-label">Name <span class="req">*</span></label>
                        <input asp-for="Name" class="crud-input" placeholder="Customer name" maxlength="100" />
                        <span asp-validation-for="Name" class="crud-error"></span>
                    </div>
                    @* Field: Email. *@
                    <div class="col-md-6">
                        <label asp-for="Email" class="crud-label">Email <span class="req">*</span></label>
                        <input asp-for="Email" type="email" class="crud-input" placeholder="name@example.com" maxlength="254" />
                        <span asp-validation-for="Email" class="crud-error"></span>
                    </div>
                    @* Field: Phone. *@
                    <div class="col-md-6">
                        <label asp-for="Phone" class="crud-label">Phone</label>
                        <input asp-for="Phone" type="tel" class="crud-input" placeholder="Optional" maxlength="20" />
                        <span asp-validation-for="Phone" class="crud-error"></span>
                    </div>
                </div>
            </div>

            @* Card: Message. *@
            <div class="crud-card">
                <div class="crud-card-title"><i class="bi bi-chat-left-text"></i> Message</div>

                @* Form fields grid. *@
                <div class="row g-3">
                    @* Field: Subject. *@
                    <div class="col-md-12">
                        <label asp-for="Subject" class="crud-label">Subject <span class="req">*</span></label>
                        <input asp-for="Subject" class="crud-input" placeholder="e.g. [Hotel Booking] Pearl Continental" maxlength="150" />
                        <span asp-validation-for="Subject" class="crud-error"></span>
                    </div>
                    @* Field: Message. *@
                    <div class="col-md-12">
                        <label asp-for="Message" class="crud-label">Message <span class="req">*</span></label>
                        <textarea asp-for="Message" class="crud-textarea" rows="7" maxlength="2000" placeholder="Write the message..." data-counter="MessageCount"></textarea>
                        <div class="crud-counter" id="MessageCount">0 / 2000</div>
                        <span asp-validation-for="Message" class="crud-error"></span>
                    </div>
                    <div class="col-md-12">
                        @{ var isIsRead = Model == null ? false : Model.IsRead; }
                        @* Availability toggle. *@
                        <label class="switch-row">
                            <span class="switch"><input type="checkbox" name="IsRead" value="true" @(isIsRead ? "checked" : "") /><span class="slider"></span></span>
                            <span><strong>Mark as read</strong><small>Read messages are no longer highlighted in the list.</small></span>
                        </label>
                        <input type="hidden" name="IsRead" value="false" />
    
                    </div>
                </div>
            </div>

        </div>

        <!-- Right: tip + buttons -->
        <div class="col-lg-4">

            @* Card: Tip. *@
            <div class="crud-card">
                <div class="crud-card-title"><i class="bi bi-lightbulb"></i> Tip</div>
                <p class="mb-0 text-muted" style="font-size:.85rem">Customer messages and orders arrive automatically from the Contact page. Editing is only needed to mark a message as read or fix a typo.</p>
            </div>

            @* Submit and cancel buttons. *@
            <div class="d-grid gap-2">
                <button type="submit" class="btn-crud btn-crud-primary justify-content-center">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn-crud btn-crud-light justify-content-center">Cancel</a>
            </div>
        </div>
    </div>
</form>

@* Page-specific scripts. *@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/admin/js/crud-form.js"></script>
}
