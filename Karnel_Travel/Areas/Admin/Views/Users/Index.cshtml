@* Model bound to this view. *@
@model Karnel_Travel.Areas.Admin.Controllers.UsersIndexViewModel

@* Page setup: title and helper variables. *@
@{
    ViewData["Title"] = "Users";

    // Range shown in the pagination summary.
    var firstItem = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}


@* Page-specific styles. *@
<style>
    /* Confirm popup for Activate / Deactivate (matches admin theme) */
    .confirm-modal .modal-content {
        border: 0;
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }
    .confirm-modal .modal-body { padding: 2rem 2rem 1.25rem; text-align: center; }
    .confirm-icon {
        width: 64px; height: 64px; margin: 0 auto 1.1rem;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.7rem;
    }
    .confirm-icon.is-danger { background: var(--sys-red-bg); color: var(--sys-red); }
    .confirm-icon.is-success { background: var(--brand-lime-translucent); color: var(--brand-forest-dark); }
    .confirm-title { font-size: 1.2rem; font-weight: 800; color: var(--text-main); margin-bottom: .4rem; }
    .confirm-text { color: var(--text-muted-green); font-size: .9rem; margin-bottom: 1.1rem; }
    .confirm-user {
        display: flex; align-items: center; gap: .75rem; text-align: left;
        background: #F8FAF9; border: 1px solid var(--border-light);
        border-radius: var(--radius-lg); padding: .75rem 1rem;
    }
    .confirm-modal .modal-footer {
        border-top: 0; padding: .25rem 2rem 1.75rem;
        justify-content: center; gap: .75rem;
    }
    .confirm-modal .modal-footer .btn-crud { min-width: 130px; justify-content: center; }
</style>

<!-- Page heading -->
<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-subtitle">Manage registered users and their account status.</p>
    </div>
</div>


<!-- User counts: Total / Active / Deactive (click a card to filter the list) -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-stat">
            @* Card header: title and link. *@
            <div class="card-header">
                <span class="stat-label">Total Users</span>
                <i class="bi bi-people text-primary fs-4"></i>
            </div>
            <div class="stat-value">@Model.AllUsers</div>
            <p class="text-muted mb-1">All registered users</p>
            <a asp-action="Index" class="small">View all &rarr;</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat">
            @* Card header: title and link. *@
            <div class="card-header">
                <span class="stat-label">Active Users</span>
                <i class="bi bi-person-check text-success fs-4"></i>
            </div>
            <div class="stat-value">@Model.ActiveUsers</div>
            <p class="text-muted mb-1">Can log in</p>
            <a asp-action="Index" asp-route-status="active" class="small">View active &rarr;</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat">
            @* Card header: title and link. *@
            <div class="card-header">
                <span class="stat-label">Deactive Users</span>
                <i class="bi bi-person-x text-danger fs-4"></i>
            </div>
            <div class="stat-value">@Model.InactiveUsers</div>
            <p class="text-muted mb-1">Blocked from login</p>
            <a asp-action="Index" asp-route-status="inactive" class="small">View deactive &rarr;</a>
        </div>
    </div>
</div>

@* Success flash message. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@* Error flash message. *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* List card: toolbar and data table. *@
<div class="table-card-custom">

    <!-- Search box + status filter -->
    <form method="get" asp-action="Index" class="crud-toolbar">
        <div class="crud-search">
            <i class="bi bi-search"></i>
            <input type="text" name="q" value="@Model.Query" placeholder="Search name or email..." autocomplete="off" />
        </div>
        <div class="crud-chips">
            <a asp-action="Index" asp-route-q="@Model.Query" class="crud-chip @(string.IsNullOrEmpty(Model.Status) ? "active" : "")">All</a>
            <a asp-action="Index" asp-route-q="@Model.Query" asp-route-status="active" class="crud-chip @(Model.Status == "active" ? "active" : "")">Active</a>
            <a asp-action="Index" asp-route-q="@Model.Query" asp-route-status="inactive" class="crud-chip @(Model.Status == "inactive" ? "active" : "")">Deactive</a>
        </div>
        <input type="hidden" name="status" value="@Model.Status" />
    </form>

    @* Empty state when there are no records. *@
    @if (!Model.Users.Any())
    {
        <div class="crud-empty">
            <i class="bi bi-people"></i>
            <strong>No users found</strong>
            <p class="mb-0">Users who register on the website will appear here.</p>
        </div>
    }
    else
    {
        @* Data table. *@
        <div class="table-responsive">
            <table class="table-custom">
                @* Table header. *@
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Country</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                @* Table body. *@
                <tbody>
                    @* Render a row for each user. *@
                    @foreach (var u in Model.Users)
                    {
                        var display = string.IsNullOrWhiteSpace(u.FullName) ? u.Email : u.FullName;
                        <tr>
                            <td>
                                <div class="table-user-cell">
                                    @* Avatar showing the first initial. *@
                                    <span class="avatar-initial">@(display.Trim().Substring(0, 1).ToUpper())</span>
                                    <div>
                                        <div class="table-user-name">@display</div>
                                        <div class="table-user-sub">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(u.Country) ? "-" : u.Country)</td>
                            <td>@u.Role</td>
                            <td>
                                @if (u.IsActive) { <span class="badge-table success">Active</span> }
                                else { <span class="badge-table failed">Deactive</span> }
                            </td>
                            @* Row actions. *@
                            <td class="text-end">
                                @* Admin accounts cannot be activated or deactivated. *@
                                @if (u.Role == "Admin")
                                {
                                    <span class="table-user-sub">-</span>
                                }
                                else
                                {
                                    @* Toggle form, submitted after the confirm popup. *@
                                    <form asp-action="ToggleStatus" method="post" class="d-inline js-toggle-form">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="q" value="@Model.Query" />
                                        <input type="hidden" name="status" value="@Model.Status" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        @* Show Deactivate for active users, Activate otherwise. *@
                                        @if (u.IsActive)
                                        {
                                            <button type="button" class="btn-crud btn-crud-light js-toggle-btn" style="padding:.35rem .8rem;font-size:.8rem"
                                                    data-mode="deactivate" data-name="@display" data-email="@u.Email">
                                                <i class="bi bi-person-x"></i> Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-crud btn-crud-primary js-toggle-btn" style="padding:.35rem .8rem;font-size:.8rem"
                                                    data-mode="activate" data-name="@display" data-email="@u.Email">
                                                <i class="bi bi-person-check"></i> Activate
                                            </button>
                                        }
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination: 10 users per page -->
        <div class="table-footer-control">
            <div class="table-pagination-info">Showing @firstItem-@lastItem of @Model.TotalItems users</div>

            @if (Model.TotalPages > 1)
            {
                var start = Math.Max(1, Model.Page - 2);
                var end = Math.Min(Model.TotalPages, Model.Page + 2);
                @* Pagination links. *@
                <nav aria-label="Users pages">
                    <ul class="pagination mb-0">
                        @* Previous page link. *@
                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Query" asp-route-status="@Model.Status">Previous</a>
                        </li>
                        @* Numbered page links. *@
                        @for (var p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-q="@Model.Query" asp-route-status="@Model.Status">@p</a>
                            </li>
                        }
                        @* Next page link. *@
                        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Query" asp-route-status="@Model.Status">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

<!-- Confirm popup (shared by all rows) -->
<div class="modal fade confirm-modal" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px">
        <div class="modal-content">
            <div class="modal-body">
                <div class="confirm-icon" id="confirmIcon"><i class="bi" id="confirmIconGlyph"></i></div>
                <div class="confirm-title" id="confirmTitle"></div>
                <p class="confirm-text" id="confirmText"></p>
                <div class="confirm-user">
                    <span class="avatar-initial" id="confirmAvatar"></span>
                    <div>
                        <div class="table-user-name" id="confirmName"></div>
                        <div class="table-user-sub" id="confirmEmail"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-crud btn-crud-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-crud" id="confirmOk"></button>
            </div>
        </div>
    </div>
</div>

@* Page-specific scripts. *@
@section Scripts {
    @* Inline page script. *@
    <script>
        // Opens the confirm popup and submits the matching row form when the admin confirms
        (function () {
            // Modal and button references.
            var modalEl = document.getElementById('confirmModal');
            var modal = new bootstrap.Modal(modalEl);
            var okBtn = document.getElementById('confirmOk');
            // Form waiting for confirmation.
            var pendingForm = null;

            // Attach a click handler to every toggle button.
            document.querySelectorAll('.js-toggle-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    // Decide the action and remember the row form.
                    var deactivate = btn.dataset.mode === 'deactivate';
                    var name = btn.dataset.name;
                    pendingForm = btn.closest('form');

                    // Style the popup for the chosen action.
                    document.getElementById('confirmIcon').className =
                        'confirm-icon ' + (deactivate ? 'is-danger' : 'is-success');
                    document.getElementById('confirmIconGlyph').className =
                        'bi ' + (deactivate ? 'bi-person-x' : 'bi-person-check');
                    // Set the popup title and message.
                    document.getElementById('confirmTitle').textContent =
                        deactivate ? 'Deactivate this user?' : 'Activate this user?';
                    document.getElementById('confirmText').textContent = deactivate
                        ? 'This user will be signed out and will not be able to log in until you activate the account again.'
                        : 'This user will be able to log in to the website again.';
                    // Show the selected user in the popup.
                    document.getElementById('confirmAvatar').textContent = name.trim().charAt(0).toUpperCase();
                    document.getElementById('confirmName').textContent = name;
                    document.getElementById('confirmEmail').textContent = btn.dataset.email;

                    // Style and label the confirm button.
                    okBtn.className = 'btn-crud ' + (deactivate ? 'btn-crud-danger' : 'btn-crud-primary');
                    okBtn.innerHTML = deactivate
                        ? '<i class="bi bi-person-x"></i> Deactivate'
                        : '<i class="bi bi-person-check"></i> Activate';

                    // Open the popup.
                    modal.show();
                });
            });

            // Submit the stored form on confirm.
            okBtn.addEventListener('click', function () {
                if (pendingForm) pendingForm.submit();
            });
        })();
    </script>
}
