@model Karnel_Travel.Models.TravelInfo

@{
    ViewData["Title"] = "Travel Info Details";
}

<!-- Page heading -->
<div class="page-header">
    <div>
        <h1 class="page-title">@Model.FromCity &rarr; @Model.ToCity</h1>
        <p class="page-subtitle"><span class="mode-pill">@Model.TransportMode</span></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn-crud btn-crud-light"><i class="bi bi-arrow-left"></i> Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-crud btn-crud-primary"><i class="bi bi-pencil-square"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-crud btn-crud-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>

<div class="row g-4">
    <!-- Information -->
    <div class="col-lg-8">
        <div class="crud-card">
            <div class="crud-card-title"><i class="bi bi-info-circle"></i> Information</div>

            <div class="detail-row">
                <div class="k">Transport</div>
                <div class="v">@Model.TransportMode</div>
            </div>
            <div class="detail-row">
                <div class="k">From</div>
                <div class="v">@Model.FromCity</div>
            </div>
            <div class="detail-row">
                <div class="k">To</div>
                <div class="v">@Model.ToCity</div>
            </div>
            <div class="detail-row">
                <div class="k">Fare</div>
                <div class="v">Rs @Model.Fare.ToString("0.##")</div>
            </div>
            <div class="detail-row">
                <div class="k">Details</div>
                <div class="v">@(string.IsNullOrWhiteSpace(Model.Details) ? "No details added." : Model.Details)</div>
            </div>
        </div>
    </div>
</div>
