@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-head">
    <span class="auth-icon"><i class="fa fa-lock"></i></span>
    <div>
        <h3>@ViewData["Title"]</h3>
        <p>Use a strong password you don't use anywhere else</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="manage-form">
    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.OldPassword" class="auth-label"></label>
        <div class="auth-input-wrap has-toggle">
            <i class="fa fa-lock auth-input-icon"></i>
            <input asp-for="Input.OldPassword" class="auth-input" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
            <button type="button" class="auth-toggle" data-toggle-password="#Input_OldPassword" aria-label="Show or hide password">
                <i class="fa fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="auth-error"></span>
    </div>
    <div class="auth-field">
        <label asp-for="Input.NewPassword" class="auth-label"></label>
        <div class="auth-input-wrap has-toggle">
            <i class="fa fa-lock auth-input-icon"></i>
            <input asp-for="Input.NewPassword" class="auth-input" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
            <button type="button" class="auth-toggle" data-toggle-password="#Input_NewPassword" aria-label="Show or hide password">
                <i class="fa fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.NewPassword" class="auth-error"></span>
    </div>
    <div class="auth-field">
        <label asp-for="Input.ConfirmPassword" class="auth-label"></label>
        <div class="auth-input-wrap has-toggle">
            <i class="fa fa-lock auth-input-icon"></i>
            <input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
            <button type="button" class="auth-toggle" data-toggle-password="#Input_ConfirmPassword" aria-label="Show or hide password">
                <i class="fa fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="auth-error"></span>
    </div>

    <button type="submit" class="btn btn-primary auth-btn w-100">
        <i class="fa fa-key me-2"></i>Update password
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
