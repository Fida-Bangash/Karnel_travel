@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="manage-head">
    <span class="auth-icon is-danger"><i class="fa fa-trash-alt"></i></span>
    <div>
        <h3>@ViewData["Title"]</h3>
        <p>Close your account for good</p>
    </div>
</div>

<div class="manage-note is-warning" role="alert">
    <i class="fa fa-exclamation-triangle"></i>
    <span><strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong></span>
</div>

<form id="delete-user" method="post" class="manage-form">
    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>
    @if (Model.RequirePassword)
    {
        <div class="auth-field">
            <label asp-for="Input.Password" class="auth-label"></label>
            <div class="auth-input-wrap has-toggle">
                <i class="fa fa-lock auth-input-icon"></i>
                <input asp-for="Input.Password" class="auth-input" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                <button type="button" class="auth-toggle" data-toggle-password="#Input_Password" aria-label="Show or hide password">
                    <i class="fa fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="auth-error"></span>
        </div>
    }
    <button class="btn btn-danger auth-btn w-100" type="submit">
        <i class="fa fa-trash-alt me-2"></i>Delete data and close my account
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
