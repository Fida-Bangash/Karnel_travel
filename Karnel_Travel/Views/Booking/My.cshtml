@model Karnel_Travel.Models.MyBookingsViewModel
@{
    ViewData["Title"] = "My Bookings";
    string Tab(string? key) => (Model.Status ?? "") == (key ?? "") ? "active" : "";
}

@section Styles { <partial name="_Styles" /> }

<div class="vip-page py-4">
    <div class="vip-head">
        <span class="vip-eyebrow">Your journeys</span>
        <h1 class="vip-title">My <span>Bookings</span></h1>
        <p class="vip-sub">Track every reservation, see its status and manage it in one place.</p>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="vip-alert success"><i class="fa fa-check-circle mt-1"></i><div>@ok</div></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="vip-alert error"><i class="fa fa-exclamation-circle mt-1"></i><div>@err</div></div>
    }

    <div class="vip-tabs">
        <a class="vip-tab @Tab(null)" asp-action="My">All <em>@Model.All</em></a>
        <a class="vip-tab @Tab("pending")" asp-action="My" asp-route-status="pending">Pending <em>@Model.Pending</em></a>
        <a class="vip-tab @Tab("confirmed")" asp-action="My" asp-route-status="confirmed">Confirmed <em>@Model.Confirmed</em></a>
        <a class="vip-tab @Tab("completed")" asp-action="My" asp-route-status="completed">Completed <em>@Model.Done</em></a>
        <a class="vip-tab @Tab("closed")" asp-action="My" asp-route-status="closed">Cancelled <em>@Model.Closed</em></a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (!Model.Bookings.Any())
            {
                <div class="vip-card vip-empty">
                    <i class="fa fa-suitcase-rolling"></i>
                    <h4>No bookings here yet</h4>
                    <p class="vip-muted mb-4">Find a hotel, resort, restaurant or a tour package and reserve it in a minute.</p>
                    <a asp-controller="Information" asp-action="Index" class="vip-btn vip-btn-gold"><i class="fa fa-compass"></i> Start exploring</a>
                </div>
            }
            else
            {
                foreach (var b in Model.Bookings)
                {
                    <div class="vip-card vip-bk">
                        <div class="vip-bk-icon"><i class="fa @BookingUi.TypeIcon(b.ItemType)"></i></div>
                        <div>
                            <div class="vip-code-sm">@b.BookingCode</div>
                            <h5>@b.ItemName</h5>
                            <div class="vip-muted small">@BookingUi.TypeLabel(b.ItemType)@(string.IsNullOrWhiteSpace(b.ItemLocation) ? "" : " · " + b.ItemLocation)</div>
                            <div class="vip-bk-meta">
                                <span><i class="fa fa-calendar-alt"></i>@BookingUi.When(b)</span>
                                <span><i class="fa fa-users"></i>@BookingUi.UnitsLabel(b)</span>
                            </div>
                        </div>
                        <div class="vip-bk-side">
                            <span class="vip-status @BookingUi.StatusClass(b.Status)">@BookingUi.StatusLabel(b.Status)</span>
                            <div class="vip-bk-price">@(b.TotalPrice > 0 ? BookingUi.Money(b.TotalPrice) : "Price on confirmation")</div>
                            <a asp-action="Details" asp-route-id="@b.Id" class="vip-btn vip-btn-ghost vip-btn-sm">View details</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
