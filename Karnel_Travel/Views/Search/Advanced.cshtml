@model Karnel_Travel.Models.SearchViewModel

@{
    ViewData["Title"] = "Advanced Search";

    // Hotels, restaurants aur resorts ko ek hi card format me tayyar karo
    // (Name, Location, Image, DefaultImage, Desc, DefaultDesc, Price, Unit, ContactType, ButtonText, Available, Rating, Extra, Badge, BadgeClass)
    var hotelCards = Model.Hotels.Select(h => (h.Name, h.Location, h.ImagePath, "/img/destination-1.jpg", h.Description, "Enjoy a comfortable stay with Karnel Travel.",
        "Rs " + h.Price.ToString("0.##"), "/ night", "Hotel:" + h.Id, "Book Now", h.IsAvailable, h.Rating, h.Quantity + " rooms available",
        h.IsAvailable ? "Available" : "Not Available", h.IsAvailable ? "bg-primary" : "bg-danger")).ToList();

    var restaurantCards = Model.Restaurants.Select(r => (r.Name, r.Location, r.ImagePath, "/img/destination-3.jpg", r.Description, "Enjoy great food with Karnel Travel.",
        "Rs " + r.Price.ToString("0.##"), "/ avg. meal", "Restaurant:" + r.Id, "Reserve Table", r.IsAvailable, r.Rating,
        r.IsAvailable ? r.Quantity + " tables available" : "Not Available",
        string.IsNullOrWhiteSpace(r.Cuisine) ? "Restaurant" : r.Cuisine, "bg-primary")).ToList();

    var resortCards = Model.Resorts.Select(r => (r.Name, r.Location, r.ImagePath, "/img/destination-2.jpg", r.Description, "Enjoy a relaxing holiday with Karnel Travel.",
        "Rs " + r.Price.ToString("0.##"), "", "Resort:" + r.Id, "Book Now", r.IsAvailable, r.Rating, r.Quantity + " units available",
        r.IsAvailable ? "Available" : "Not Available", r.IsAvailable ? "bg-primary" : "bg-danger")).ToList();

    var sections = new[]
    {
        (Title: "Hotel Results",      Icon: "fa-hotel",          Items: hotelCards,      Empty: "hotels"),
        (Title: "Restaurant Results", Icon: "fa-utensils",       Items: restaurantCards, Empty: "restaurants"),
        (Title: "Resort Results",     Icon: "fa-umbrella-beach", Items: resortCards,     Empty: "resorts")
    };

    var total = Model.Spots.Count + hotelCards.Count + restaurantCards.Count + resortCards.Count;

    // Spots me price/rating/quantity/availability nahi hota, isliye in filters par spots hide ho jate hain
    var spotsHidden = Model.MaxPrice.HasValue || Model.MinRating.HasValue || Model.MinQuantity.HasValue || Model.AvailableOnly;

    // Active filters ki list (chips me dikhane ke liye)
    var activeFilters = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Keyword)) activeFilters.Add("Keyword: " + Model.Keyword);
    if (!string.IsNullOrWhiteSpace(Model.Location)) activeFilters.Add("Location: " + Model.Location);
    if (Model.MaxPrice.HasValue) activeFilters.Add("Max price: Rs " + Model.MaxPrice.Value.ToString("0.##"));
    if (Model.MinRating.HasValue) activeFilters.Add(Model.MinRating.Value + "★ & above");
    if (Model.MinQuantity.HasValue) activeFilters.Add("Min available: " + Model.MinQuantity.Value);
    if (Model.AvailableOnly) activeFilters.Add("Available only");
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1>Advanced Search</h1>
        <p class="text-muted">
            Filter hotels, restaurants and resorts by keyword, location, price, rating, quantity and availability.
        </p>
    </div>

    <!-- ================= Filter form ================= -->
    <div class="card border-0 shadow-sm mb-5 overflow-hidden">

        <!-- Primary strip -->
        <div class="bg-primary text-white fw-bold px-4 py-3">
            <i class="fa fa-sliders-h me-2"></i>Search Filters
        </div>

        <div class="card-body p-4">

            <form asp-controller="Search" asp-action="Advanced" method="get">

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Keyword</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-primary"><i class="fa fa-search"></i></span>
                            <input type="text" name="Keyword" value="@Model.Keyword"
                                   class="form-control" placeholder="Name or cuisine..." />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Location</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-primary"><i class="fa fa-map-marker-alt"></i></span>
                            <input type="text" name="Location" value="@Model.Location"
                                   class="form-control" placeholder="e.g. Karachi, Murree" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Maximum Price</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-primary">Rs</span>
                            <input type="number" name="MaxPrice" value="@Model.MaxPrice"
                                   min="0" step="0.01" class="form-control" placeholder="Enter maximum price" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Minimum Rating</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-warning"><i class="fa fa-star"></i></span>
                            <select name="MinRating" class="form-select">
                                <option value="">Any Rating</option>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <option value="@i" selected="@(Model.MinRating == i)">@i Stars &amp; Above</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Minimum Available (rooms / tables)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-primary"><i class="fa fa-bed"></i></span>
                            <input type="number" name="MinQuantity" value="@Model.MinQuantity"
                                   min="0" class="form-control" placeholder="e.g. 2" />
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input type="checkbox" name="AvailableOnly" value="true"
                                   class="form-check-input" id="availableOnly" checked="@Model.AvailableOnly" />
                            <label class="form-check-label" for="availableOnly">
                                Show available only <span class="text-muted">(hotels, restaurants, resorts)</span>
                            </label>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4 me-2 mt-3">
                            <i class="fa fa-filter me-1"></i> Apply Filters
                        </button>
                        <a asp-action="Advanced" class="btn btn-outline-secondary px-4 me-2 mt-3">
                            <i class="fa fa-undo me-1"></i> Reset
                        </a>
                        <a asp-action="Index" class="btn btn-outline-primary px-4 mt-3">
                            <i class="fa fa-search me-1"></i> Simple Search
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- ================= Results summary ================= -->
    <div class="text-center mb-5">
        <h3 class="mb-1">Search Results</h3>
        <p class="text-muted mb-2">@total @(total == 1 ? "result" : "results") found</p>
        @foreach (var f in activeFilters)
        {
            <span class="badge bg-primary rounded-pill px-3 py-2 me-1 mb-1">@f</span>
        }
    </div>

    @if (total == 0)
    {
        @* Nothing found anywhere: one big friendly message *@
        <div class="card border-0 shadow-sm text-center p-5 mx-auto" style="max-width:600px;">
            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white mx-auto mb-4"
                 style="width:90px; height:90px; font-size:2.2rem;">
                <i class="fa fa-search"></i>
            </div>
            <h4 class="fw-bold mb-2">No results found</h4>
            <p class="text-muted mb-4">
                Nothing matched your filters.<br />
                Try a higher price, a lower rating or remove some filters.
            </p>
            <div>
                <a asp-action="Advanced" class="btn btn-primary px-4 me-2">
                    <i class="fa fa-undo me-1"></i> Reset Filters
                </a>
                <a asp-controller="Information" asp-action="Index" class="btn btn-outline-primary px-4">
                    Browse Information
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Hotels, Restaurants, Resorts -->
        @foreach (var sec in sections)
        {
            <div class="d-flex align-items-center mb-3 mt-4">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white me-3"
                      style="width:42px; height:42px;"><i class="fa @sec.Icon"></i></span>
                <h4 class="mb-0">@sec.Title</h4>
                <span class="badge bg-primary rounded-pill ms-3">@sec.Items.Count</span>
            </div>

            @if (sec.Items.Any())
            {
                <div class="row g-4 mb-4">
                    @foreach (var c in sec.Items)
                    {
                        var img = string.IsNullOrWhiteSpace(c.Item3) ? c.Item4 : c.Item3;

                        <div class="col-lg-4 col-md-6">

                            @* Same card style as tourist spots (spot-card) *@
                            <div class="card spot-card h-100 border-0 shadow-sm">

                                <!-- Image + badge -->
                                <div class="position-relative overflow-hidden">
                                    <img src="@Url.Content(img)" class="card-img-top spot-card-img" alt="@c.Item1" />
                                    <span class="badge @c.Item15 position-absolute top-0 start-0 m-3 px-3 py-2">@c.Item14</span>
                                </div>

                                <div class="card-body d-flex flex-column">

                                    <h5 class="mb-1">@c.Item1</h5>

                                    <p class="text-muted mb-2">
                                        <i class="fa fa-map-marker-alt text-primary me-2"></i>@c.Item2
                                    </p>

                                    <!-- Rating + quantity -->
                                    <p class="mb-2 small">
                                        <span class="text-warning">@(new string('★', c.Item12))</span>
                                        <span class="text-muted ms-2">&middot; @c.Item13</span>
                                    </p>

                                    <!-- Short description (max 3 lines) -->
                                    <p class="spot-card-desc flex-grow-1">
                                        @(string.IsNullOrWhiteSpace(c.Item5) ? c.Item6 : c.Item5)
                                    </p>

                                    <!-- Price (left) + button (right) -->
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div>
                                            <span class="fs-4 fw-bold text-primary">@c.Item7</span>
                                            <small class="text-muted">@c.Item8</small>
                                        </div>

                                        @if (c.Item11)
                                        {
                                            <a asp-controller="Booking" asp-action="Create"
                                               asp-route-type="@(c.Item9.Split(':')[0])" asp-route-id="@(c.Item9.Split(':')[1])"
                                               class="btn btn-primary btn-sm">
                                                <i class="fa fa-paper-plane me-1"></i> @c.Item10
                                            </a>
                                        }
                                    </div>

                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                @* This category has no match: small friendly note *@
                <div class="border rounded text-center text-muted py-4 mb-4 bg-light">
                    <i class="fa fa-search me-2"></i>No @sec.Empty matched your filters
                </div>
            }
        }

        <!-- Tourist Spots -->
        <div class="d-flex align-items-center mb-3 mt-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white me-3"
                  style="width:42px; height:42px;"><i class="fa fa-map-marked-alt"></i></span>
            <h4 class="mb-0">Tourist Spots</h4>
            <span class="badge bg-primary rounded-pill ms-3">@Model.Spots.Count</span>
        </div>

        @if (Model.Spots.Any())
        {
            <div class="row g-4 mb-4">
                @foreach (var s in Model.Spots)
                {
                    <div class="col-lg-4 col-md-6">
                        <partial name="_SpotCard" model="s" />
                    </div>
                }
            </div>
        }
        else if (spotsHidden)
        {
            <div class="border rounded text-center text-muted py-4 mb-4 bg-light">
                <i class="fa fa-info-circle me-2"></i>Tourist spots are hidden when price, rating, quantity or availability filters are used.
            </div>
        }
        else
        {
            <div class="border rounded text-center text-muted py-4 mb-4 bg-light">
                <i class="fa fa-search me-2"></i>No tourist spots matched your filters
            </div>
        }
    }

</div>
