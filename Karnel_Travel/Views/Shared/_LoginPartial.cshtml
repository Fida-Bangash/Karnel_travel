@using Microsoft.AspNetCore.Identity
@using Karnel_Travel.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="navbar-nav align-items-lg-center ms-lg-3">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = (!string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? currentUser!.FullName
        : UserManager.GetUserName(User)) ?? "User";
    var initial = displayName.Substring(0, 1).ToUpper();
    var isAdmin = User.IsInRole("Admin");

    <style>
        /* ===== User dropdown (theme: Tourist) ===== */
        .user-menu-btn {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            padding: 5px 14px 5px 5px;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, .35);
            background: rgba(255, 255, 255, .12);
            color: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: 16px;
            font-weight: 700;
            text-decoration: none;
            transition: .3s;
        }
        .user-menu-btn:hover,
        .user-menu-btn[aria-expanded="true"] {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }
        .sticky-top .user-menu-btn {
            color: var(--dark);
            border-color: #e3e6ea;
            background: #f7f9f2;
        }
        .sticky-top .user-menu-btn:hover,
        .sticky-top .user-menu-btn[aria-expanded="true"] {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }
        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            flex-shrink: 0;
        }
        .user-menu-btn:hover .user-avatar,
        .user-menu-btn[aria-expanded="true"] .user-avatar {
            background: #fff;
            color: var(--primary);
        }
        .user-menu-name {
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .user-menu-caret {
            font-size: 11px;
            transition: transform .3s;
        }
        .user-menu-btn[aria-expanded="true"] .user-menu-caret { transform: rotate(180deg); }

        .user-menu {
            min-width: 260px;
            padding: 8px;
            margin-top: 12px !important;
            border: 0;
            border-radius: 16px;
            box-shadow: 0 14px 40px rgba(20, 20, 31, .18);
            font-family: 'Nunito', sans-serif;
        }
        .user-menu-head {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 12px;
            margin-bottom: 6px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(134, 184, 23, .16), rgba(254, 136, 0, .08));
        }
        .user-menu-head .user-avatar { width: 46px; height: 46px; font-size: 20px; }
        .user-menu-info { min-width: 0; }
        .user-menu-info strong {
            display: block;
            color: var(--dark);
            font-size: 15px;
            line-height: 1.2;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .user-menu-info small {
            display: block;
            color: #6b7280;
            font-size: 12.5px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .user-role {
            display: inline-block;
            margin-top: 4px;
            padding: 1px 10px;
            border-radius: 50px;
            background: var(--primary);
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .4px;
            text-transform: uppercase;
        }
        .user-role.is-admin { background: var(--secondary); }

        .user-menu .dropdown-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            width: 100%;
            padding: 9px 12px;
            border-radius: 10px;
            color: var(--dark);
            font-size: 15px;
            font-weight: 600;
            transition: .2s;
        }
        .user-menu .dropdown-item .item-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(134, 184, 23, .12);
            color: var(--primary);
            font-size: 14px;
            transition: .2s;
        }
        .user-menu .dropdown-item:hover,
        .user-menu .dropdown-item:focus,
        .user-menu .dropdown-item:active {
            background: rgba(134, 184, 23, .1);
            color: var(--primary);
        }
        .user-menu .dropdown-item:hover .item-icon {
            background: var(--primary);
            color: #fff;
        }
        .user-menu .dropdown-divider { margin: 6px 4px; border-color: #eef0f2; }
        .user-menu .dropdown-item.logout-item .item-icon {
            background: rgba(220, 53, 69, .1);
            color: #dc3545;
        }
        .user-menu .dropdown-item.logout-item:hover,
        .user-menu .dropdown-item.logout-item:focus,
        .user-menu .dropdown-item.logout-item:active {
            background: rgba(220, 53, 69, .08);
            color: #dc3545;
        }
        .user-menu .dropdown-item.logout-item:hover .item-icon {
            background: #dc3545;
            color: #fff;
        }

        @@media (max-width: 991.98px) {
            .user-menu-btn { color: var(--dark); border-color: #ddd; background: #f7f9f2; margin: 8px 0; }
            .user-menu { box-shadow: none; border: 1px solid #eee; margin-top: 4px !important; }
        }
    </style>

    <div class="nav-item dropdown">
        <a href="#" class="user-menu-btn" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-avatar">@initial</span>
            <span class="user-menu-name">@displayName</span>
            <i class="fa fa-chevron-down user-menu-caret"></i>
        </a>

        <div class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="userDropdown">
            <div class="user-menu-head">
                <span class="user-avatar">@initial</span>
                <div class="user-menu-info">
                    <strong>@displayName</strong>
                    <small>@currentUser?.Email</small>
                    <span class="user-role @(isAdmin ? "is-admin" : "")">@(isAdmin ? "Admin" : "User")</span>
                </div>
            </div>

            @if (isAdmin)
            {
                <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="item-icon"><i class="fa fa-tachometer-alt"></i></span>Dashboard
                </a>
            }
            <a class="dropdown-item" asp-area="" asp-controller="Booking" asp-action="My">
                <span class="item-icon"><i class="fa fa-suitcase-rolling"></i></span>My Bookings
            </a>
            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                <span class="item-icon"><i class="fa fa-user"></i></span>My Profile
            </a>

            <div class="dropdown-divider"></div>

            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="dropdown-item logout-item">
                    <span class="item-icon"><i class="fa fa-sign-out-alt"></i></span>Logout
                </button>
            </form>
        </div>
    </div>
}
else
{
    <a class="nav-item nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a class="btn btn-primary rounded-pill py-2 px-4" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
</div>