@model List<Karnel_Travel.Models.Hotel>

@{
    // Set the browser page title
    ViewData["Title"] = "Hotel Information";
}

<div class="container py-5">

    <!-- Page heading -->
    <h1 class="mb-2 text-center">Hotels</h1>
    <p class="text-center text-muted mb-5">Comfortable stays for every budget.</p>

    <!-- Hotel cards grid -->
    <div class="row g-4">

        @* Render one card per hotel *@
        @foreach (var h in Model)
        {
            // If no image was uploaded, show a default picture
            var img = string.IsNullOrWhiteSpace(h.ImagePath) ? "/img/destination-1.jpg" : h.ImagePath;

            <div class="col-lg-4 col-md-6">

                @* Same card style as tourist spots (spot-card) *@
                <div class="card spot-card h-100 border-0 shadow-sm">

                    <!-- Image + availability badge -->
                    <div class="position-relative overflow-hidden">
                        <img src="@Url.Content(img)" class="card-img-top spot-card-img" alt="@h.Name" />
                        <span class="badge @(h.IsAvailable ? "bg-primary" : "bg-danger") position-absolute top-0 start-0 m-3 px-3 py-2">
                            @(h.IsAvailable ? "Available" : "Not Available")
                        </span>
                    </div>

                    <!-- Card body -->
                    <div class="card-body d-flex flex-column">

                        <!-- Name -->
                        <h5 class="mb-1">@h.Name</h5>

                        <!-- Location -->
                        <p class="text-muted mb-2">
                            <i class="fa fa-map-marker-alt text-primary me-2"></i>@h.Location
                        </p>

                        <!-- Rating + rooms -->
                        <p class="mb-2 small">
                            <span class="text-warning">@(new string('★', h.Rating))</span>
                            <span class="text-muted ms-2">&middot; @h.Quantity rooms available</span>
                        </p>

                        <!-- Short description (max 3 lines) -->
                        <p class="spot-card-desc flex-grow-1">
                            @(string.IsNullOrWhiteSpace(h.Description) ? "Enjoy a comfortable stay with Karnel Travel." : h.Description)
                        </p>

                        <!-- Price (left) + Book button (right) -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <!-- Price per night -->
                            <div>
                                <span class="fs-4 fw-bold text-primary">Rs @h.Price.ToString("0.##")</span>
                                <small class="text-muted">/ night</small>
                            </div>

                            @* Hotel available ho to Contact page khulta hai, hotel ka naam pehle se bhara hua *@
                            @if (h.IsAvailable)
                            {
                                <a asp-controller="Booking" asp-action="Create"
                                   asp-route-type="Hotel" asp-route-id="@h.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="fa fa-paper-plane me-1"></i> Book Now
                                </a>
                            }
                        </div>

                    </div>
                </div>

            </div>
        }

    </div>

    @* Message when no hotels exist *@
    @if (!Model.Any())
    {
        <p class="text-center text-muted">No hotels added yet.</p>
    }

</div>
