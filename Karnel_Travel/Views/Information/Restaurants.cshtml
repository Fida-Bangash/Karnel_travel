@model List<Karnel_Travel.Models.Restaurant>

@{
    // Set the browser page title
    ViewData["Title"] = "Restaurants";
}

<div class="container py-5">

    <!-- Page heading -->
    <h1 class="mb-2 text-center">Restaurants</h1>
    <p class="text-center text-muted mb-5">Discover great food places across the country.</p>

    <!-- Restaurant cards grid -->
    <div class="row g-4">

        @* Render one card per restaurant *@
        @foreach (var r in Model)
        {
            // If no image was uploaded, show a default picture
            var img = string.IsNullOrWhiteSpace(r.ImagePath) ? "/img/destination-1.jpg" : r.ImagePath;

            <div class="col-lg-4 col-md-6">

                @* Same card style as tourist spots (spot-card) *@
                <div class="card spot-card h-100 border-0 shadow-sm">

                    <!-- Image + cuisine badge -->
                    <div class="position-relative overflow-hidden">
                        <img src="@Url.Content(img)" class="card-img-top spot-card-img" alt="@r.Name" />
                        @* Show cuisine badge if present *@
                        @if (!string.IsNullOrWhiteSpace(r.Cuisine))
                        {
                            <span class="badge bg-primary position-absolute top-0 start-0 m-3 px-3 py-2">@r.Cuisine</span>
                        }
                    </div>

                    <!-- Card body -->
                    <div class="card-body d-flex flex-column">

                        <!-- Name -->
                        <h5 class="mb-1">@r.Name</h5>

                        <!-- Location -->
                        <p class="text-muted mb-2">
                            <i class="fa fa-map-marker-alt text-primary me-2"></i>@r.Location
                        </p>

                        <!-- Rating + availability -->
                        <p class="mb-2 small">
                            <span class="text-warning">@(new string('★', r.Rating))</span>
                            @* Show availability and table count *@
                            @if (r.IsAvailable)
                            {
                                <span class="text-success ms-2">&middot; Available &middot; @r.Quantity tables</span>
                            }
                            else
                            {
                                <span class="text-danger ms-2">&middot; Not Available</span>
                            }
                        </p>

                        <!-- Short description (max 3 lines) -->
                        <p class="spot-card-desc flex-grow-1">
                            @(string.IsNullOrWhiteSpace(r.Description) ? "Enjoy great food with Karnel Travel." : r.Description)
                        </p>

                        <!-- Average price (left) + button (right) -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <!-- Average meal price -->
                            <div>
                                <span class="fs-4 fw-bold text-primary">Rs @r.Price.ToString("0.##")</span>
                                <small class="text-muted">/ avg. meal</small>
                            </div>

                            @* Contact page opens with the restaurant name already filled in *@
                            <a asp-controller="Booking" asp-action="Create"
                               asp-route-type="Restaurant" asp-route-id="@r.Id"
                               class="btn btn-primary btn-sm">
                                <i class="fa fa-paper-plane me-1"></i> Reserve Table
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        }

    </div>

    @* Message when no restaurants exist *@
    @if (!Model.Any())
    {
        <p class="text-center text-muted">No restaurants added yet.</p>
    }

</div>
