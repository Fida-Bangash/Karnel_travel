@{
    ViewData["Title"] = "Information";
}

<div class="container py-5">

    <!-- Page Heading -->
    <div class="text-center mb-5">
        <h1>Travel Information</h1>
        <p class="text-muted">
            Explore tourist spots, travel information, hotels,
            restaurants and resorts.
        </p>
    </div>


    <!-- 5 Information Cards -->
    @{
        // Action, icon, title, short text, button text
        var infoCards = new[]
        {
            (Action: "Spots",       Icon: "fa-map-marked-alt", Title: "Tourist Spots",       Text: "Explore beautiful tourist destinations.",      Button: "Explore Spots"),
            (Action: "Travel",      Icon: "fa-bus",            Title: "Travel Information",  Text: "Find transport routes, fares and timings.",    Button: "View Travel"),
            (Action: "Hotels",      Icon: "fa-hotel",          Title: "Hotels",              Text: "Find hotels and comfortable accommodation.",   Button: "View Hotels"),
            (Action: "Restaurants", Icon: "fa-utensils",       Title: "Restaurants",         Text: "Discover restaurants and local food places.",  Button: "View Restaurants"),
            (Action: "Resorts",     Icon: "fa-umbrella-beach", Title: "Resorts",             Text: "Explore resorts and holiday destinations.",    Button: "View Resorts")
        };
    }

    <div class="row g-4 justify-content-center">

        @foreach (var c in infoCards)
        {
            <div class="col-lg-4 col-md-6">

                @* Whole card is clickable. Same look as tourist spot cards: white, light shadow, lifts on hover *@
                <a asp-controller="Information" asp-action="@c.Action" class="d-block h-100 text-decoration-none text-dark">

                    <div class="card spot-card h-100 border-0 shadow-sm">

                        <!-- Top strip in primary color -->
                        <div class="bg-primary" style="height:6px;"></div>

                        <div class="card-body d-flex flex-column align-items-center text-center p-4">

                            <!-- Icon circle -->
                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white mb-3"
                                 style="width:80px; height:80px; font-size:1.9rem;">
                                <i class="fa @c.Icon"></i>
                            </div>

                            <h4 class="fw-bold mb-2">@c.Title</h4>

                            <p class="text-muted flex-grow-1">@c.Text</p>

                            <span class="btn btn-primary btn-sm px-4 mt-2">
                                @c.Button <i class="fa fa-long-arrow-alt-right ms-1"></i>
                            </span>

                        </div>
                    </div>

                </a>

            </div>
        }

    </div>

    @{
    
    var newHotels = ViewBag.NewHotels as List<Hotel> ?? new List<Hotel>();
    var newResorts = ViewBag.NewResorts as List<Resort> ?? new List<Resort>();
    var newRestaurants = ViewBag.NewRestaurants as List<Restaurant> ?? new List<Restaurant>();
    var packages = ViewBag.Packages as List<TourPackage> ?? new List<TourPackage>();
}

<!-- Newly Added -->
@{
    // Hotels, resorts aur restaurants ko ek hi list me jama karo taake ek hi card design use ho
    var newItems = new List<(string Type, string Name, string Location, string? Image, string DefaultImage, string? Desc, string Price, string Unit, string ContactType, string ButtonText, bool Available)>();

    foreach (var h in newHotels)
        newItems.Add(("Hotel", h.Name, h.Location, h.ImagePath, "/img/destination-1.jpg", h.Description, "Rs " + h.Price.ToString("0.##"), "/ night", "Hotel:" + h.Id, "Book Now", h.IsAvailable));

    foreach (var r in newResorts)
        newItems.Add(("Resort", r.Name, r.Location, r.ImagePath, "/img/destination-2.jpg", r.Description, "Rs " + r.Price.ToString("0.##"), "", "Resort:" + r.Id, "Book Now", r.IsAvailable));

    foreach (var r in newRestaurants)
        newItems.Add(("Restaurant", r.Name, r.Location, r.ImagePath, "/img/destination-3.jpg", r.Description, "Rs " + r.Price.ToString("0.##"), "/ avg. meal", "Restaurant:" + r.Id, "Reserve Table", r.IsAvailable));
}

<div class="mt-5">
    <h2 class="mb-4 text-center">Newly Added</h2>
    <div class="row g-4">

        @foreach (var item in newItems)
        {
            var img = string.IsNullOrWhiteSpace(item.Image) ? item.DefaultImage : item.Image;

            <div class="col-lg-4 col-md-6">

                @* Same card style as tourist spots (spot-card) *@
                <div class="card spot-card h-100 border-0 shadow-sm">

                    <!-- Image + type badge (Hotel / Resort / Restaurant) -->
                    <div class="position-relative overflow-hidden">
                        <img src="@Url.Content(img)" class="card-img-top spot-card-img" alt="@item.Name" />
                        <span class="badge bg-primary position-absolute top-0 start-0 m-3 px-3 py-2">@item.Type</span>
                    </div>

                    <div class="card-body d-flex flex-column">

                        <!-- Name -->
                        <h5 class="mb-1">@item.Name</h5>

                        <!-- Location -->
                        <p class="text-muted mb-2">
                            <i class="fa fa-map-marker-alt text-primary me-2"></i>@item.Location
                        </p>

                        <!-- Short description (max 3 lines) -->
                        <p class="spot-card-desc flex-grow-1">
                            @(string.IsNullOrWhiteSpace(item.Desc) ? "Newly added on Karnel Travel." : item.Desc)
                        </p>

                        <!-- Price (left) + button (right) -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div>
                                <span class="fs-4 fw-bold text-primary">@item.Price</span>
                                <small class="text-muted">@item.Unit</small>
                            </div>

                            @* Contact page opens with the type and name already filled in *@
                            @if (item.Available)
                            {
                                <a asp-controller="Booking" asp-action="Create"
                                   asp-route-type="@(item.ContactType.Split(':')[0])" asp-route-id="@(item.ContactType.Split(':')[1])"
                                   class="btn btn-primary btn-sm">
                                    <i class="fa fa-paper-plane me-1"></i> @item.ButtonText
                                </a>
                            }
                        </div>

                    </div>
                </div>

            </div>
        }

    </div>

    @if (!newItems.Any())
    {
        <p class="text-center text-muted">No new listings yet.</p>
    }
</div>

<!-- Tour Packages -->
<div class="mt-5">

    <h2 class="mb-4 text-center">
        Tour Packages & Discounts
    </h2>

    <div class="row g-4">

        @foreach (var p in packages)
        {
            var pkgImg = string.IsNullOrWhiteSpace(p.ImagePath) ? "/img/destination-4.jpg" : p.ImagePath;

            <div class="col-lg-4 col-md-6">

                @* Same card style as tourist spots (spot-card) *@
                <div class="card spot-card h-100 border-0 shadow-sm">

                    <!-- Image + discount badge -->
                    <div class="position-relative overflow-hidden">
                        <img src="@Url.Content(pkgImg)" class="card-img-top spot-card-img" alt="@p.Title" />
                        <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2">@p.DiscountPercent% OFF</span>
                    </div>

                    <div class="card-body d-flex flex-column">

                        <!-- Title -->
                        <h5 class="mb-1">@p.Title</h5>

                        @if (p.Price > 0)
                        {
                            <p class="mb-2"><span class="fs-5 fw-bold text-primary">Rs @p.Price.ToString("#,##0.##")</span> <small class="text-muted">/ person</small></p>
                        }

                        <!-- Valid till -->
                        @if (p.ValidTill != null)
                        {
                            <p class="text-muted mb-2">
                                <i class="fa fa-calendar-alt text-primary me-2"></i>Valid till @p.ValidTill?.ToString("dd MMM yyyy")
                            </p>
                        }

                        <!-- Short details (max 3 lines) -->
                        <p class="spot-card-desc flex-grow-1">
                            @(string.IsNullOrWhiteSpace(p.Details) ? "Special offer from Karnel Travel." : p.Details)
                        </p>

                        @* Order Now button: Contact page par package ka naam pehle se bhar ke le jata hai *@
                        <a asp-controller="Booking" asp-action="Create"
                           asp-route-type="Package" asp-route-id="@p.Id"
                           class="btn btn-primary btn-sm mt-2 align-self-start">
                            <i class="fa fa-paper-plane me-1"></i> Book Now
                        </a>

                    </div>
                </div>

            </div>
        }

        @if (!packages.Any())
        {
            <div class="col-12">
                <p class="text-center text-muted">No offers available right now.</p>
            </div>
        }

    </div>

</div>

</div>
