@model List<Karnel_Travel.Models.TouristSpot>

@{
    ViewData["Title"] = "Tourist Spots";
}

<div class="container py-5">

    <h1 class="mb-2 text-center">Tourist Spots</h1>
    <p class="text-center text-muted mb-5">Beaches, monuments and attractions across the country.</p>

    <div class="row g-4">

        @foreach (var spot in Model)
        {
            <div class="col-lg-4 col-md-6">
                <partial name="_SpotCard" model="spot" />
            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-muted">No tourist spots added yet.</p>
    }

</div>
