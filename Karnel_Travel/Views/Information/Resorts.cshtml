@model List<Karnel_Travel.Models.Resort>

@{
    ViewData["Title"] = "Resorts";
}

<div class="container py-5">

    <h1 class="mb-2 text-center">Resorts</h1>
    <p class="text-center text-muted mb-5">Relax at the best holiday resorts.</p>

    <div class="row g-4">

        @foreach (var r in Model)
        {
            // If no image was uploaded, show a default picture
            var img = string.IsNullOrWhiteSpace(r.ImagePath) ? "/img/destination-1.jpg" : r.ImagePath;

            <div class="col-lg-4 col-md-6">

                @* Same card style as tourist spots (spot-card) *@
                <div class="card spot-card h-100 border-0 shadow-sm">

                    <!-- Image + availability badge -->
                    <div class="position-relative overflow-hidden">
                        <img src="@Url.Content(img)" class="card-img-top spot-card-img" alt="@r.Name" />
                        <span class="badge @(r.IsAvailable ? "bg-primary" : "bg-danger") position-absolute top-0 start-0 m-3 px-3 py-2">
                            @(r.IsAvailable ? "Available" : "Not Available")
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column">

                        <!-- Name -->
                        <h5 class="mb-1">@r.Name</h5>

                        <!-- Location -->
                        <p class="text-muted mb-2">
                            <i class="fa fa-map-marker-alt text-primary me-2"></i>@r.Location
                        </p>

                        <!-- Rating + units -->
                        <p class="mb-2 small">
                            <span class="text-warning">@(new string('★', r.Rating))</span>
                            <span class="text-muted ms-2">&middot; @r.Quantity units available</span>
                        </p>

                        <!-- Short description (max 3 lines) -->
                        <p class="spot-card-desc flex-grow-1">
                            @(string.IsNullOrWhiteSpace(r.Description) ? "Enjoy a relaxing holiday with Karnel Travel." : r.Description)
                        </p>

                        <!-- Price (left) + Book button (right) -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fs-4 fw-bold text-primary">Rs @r.Price.ToString("0.##")</span>

                            @* Resort available ho to Contact page khulta hai, resort ka naam pehle se bhara hua *@
                            @if (r.IsAvailable)
                            {
                                <a asp-controller="Booking" asp-action="Create"
                                   asp-route-type="Resort" asp-route-id="@r.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="fa fa-paper-plane me-1"></i> Book Now
                                </a>
                            }
                        </div>

                    </div>
                </div>

            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-muted">No resorts added yet.</p>
    }

</div>
