@model List<Karnel_Travel.Models.TravelInfo>

@{
    ViewData["Title"] = "Travel Information";
}

@* Small styles for the travel card (same look as the tourist spot card) *@
<style>
    .travel-card { transition: transform .25s ease, box-shadow .25s ease; border-radius: 6px; overflow: hidden; }
    .travel-card:hover { transform: translateY(-5px); box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .12) !important; }
    .travel-card-desc {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container py-5">

    <h1 class="mb-2 text-center">Travel Information</h1>
    <p class="text-center text-muted mb-5">Transport options, routes and fares between cities.</p>

    <div class="row g-4">

        @foreach (var travel in Model)
        {
            // Choose an icon from the transport mode name
            var mode = (travel.TransportMode ?? "").ToLower();
            var icon = mode.Contains("bus") ? "fa-bus"
                     : mode.Contains("train") ? "fa-train"
                     : (mode.Contains("flight") || mode.Contains("air")) ? "fa-plane"
                     : (mode.Contains("ship") || mode.Contains("boat")) ? "fa-ship"
                     : mode.Contains("van") ? "fa-shuttle-van"
                     : mode.Contains("car") ? "fa-car"
                     : "fa-truck";

            // Text that is pre-filled in the Contact form when the customer clicks the button

            <div class="col-lg-4 col-md-6">

                <div class="card travel-card h-100 border-0 shadow-sm">

                    <!-- Top bar: transport icon + name -->
                    <div class="bg-primary text-white px-4 py-3 d-flex align-items-center">
                        <i class="fa @icon fa-lg me-3"></i>
                        <span class="fw-bold text-uppercase">@travel.TransportMode</span>
                    </div>

                    <div class="card-body d-flex flex-column">

                        <!-- Route on one line -->
                        <h4 class="text-center my-3">
                            @travel.FromCity
                            <i class="fa fa-arrow-right text-primary mx-2"></i>
                            @travel.ToCity
                        </h4>

                        <!-- Details (max 3 lines) -->
                        <p class="travel-card-desc text-muted flex-grow-1">
                            @(string.IsNullOrWhiteSpace(travel.Details) ? "Comfortable and reliable travel with Karnel Travel." : travel.Details)
                        </p>

                        <!-- Fare + booking button -->
                        <div class="d-flex align-items-center justify-content-between border-top pt-3 mt-2">
                            <div>
                                <small class="text-muted d-block">Fare</small>
                                <span class="h4 text-primary mb-0">Rs @travel.Fare.ToString("0.##")</span>
                            </div>

                            <a asp-controller="Booking" asp-action="Create"
                               asp-route-type="Transport" asp-route-id="@travel.Id"
                               class="btn btn-primary btn-sm">
                                <i class="fa fa-paper-plane me-1"></i> Book Now
                            </a>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-muted">No travel options added yet.</p>
    }

</div>
