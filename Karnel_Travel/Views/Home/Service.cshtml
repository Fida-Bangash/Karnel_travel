@{
    // Set the browser page title
    ViewData["Title"] = "Services";
}

@* Hero banner section *@
@section Hero {
<!-- Hero header container -->
<div class="container-fluid bg-primary py-5 mb-5 hero-header">
            <div class="container py-5">
                <div class="row justify-content-center py-5">
                    <div class="col-lg-10 pt-lg-5 mt-lg-5 text-center">
                        <h1 class="display-3 text-white animated slideInDown">Services</h1>
                        <!-- Breadcrumb navigation -->
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb justify-content-center">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item text-white active" aria-current="page">Services</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
}

    <!-- Service Start -->
    <div class="container-fluid py-5">
        <div class="container">
            <!-- Section heading -->
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="section-title bg-white text-center text-primary px-3">Services</h6>
                <h1 class="mb-5">Our Services</h1>
            </div>
            <!-- Service cards grid -->
            <div class="row g-4">
                <!-- Service card: tourist spots -->
                <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-map-marked-alt text-primary mb-4"></i>
            <h5>Tourist Spots</h5>
            <p>Beaches, monuments and attractions across the country.</p>
        </div>
    </div>
</div>
<!-- Service card: travel information -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-bus text-primary mb-4"></i>
            <h5>Travel Information</h5>
            <p>Transport options, routes and fares between cities.</p>
        </div>
    </div>
</div>
<!-- Service card: hotels -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-hotel text-primary mb-4"></i>
            <h5>Hotel Information</h5>
            <p>Hotels with price, rating and room availability.</p>
        </div>
    </div>
</div>
<!-- Service card: restaurants -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-utensils text-primary mb-4"></i>
            <h5>Restaurant Information</h5>
            <p>Find good places to eat in every city.</p>
        </div>
    </div>
</div>
<!-- Service card: resorts -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-umbrella-beach text-primary mb-4"></i>
            <h5>Resort Information</h5>
            <p>Holiday resorts for families and groups.</p>
        </div>
    </div>
</div>
<!-- Service card: tour packages -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-tags text-primary mb-4"></i>
            <h5>Tour Packages</h5>
            <p>Special packages and discounts for travellers.</p>
        </div>
    </div>
</div>
<!-- Service card: search -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-search text-primary mb-4"></i>
            <h5>Easy Search</h5>
            <p>Search by location, price, quality and availability.</p>
        </div>
    </div>
</div>
<!-- Service card: customer support -->
<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
    <div class="service-item rounded pt-3">
        <div class="p-4">
            <i class="fa fa-3x fa-headset text-primary mb-4"></i>
            <h5>Customer Support</h5>
            <p>Contact us any time to place an order or share feedback.</p>
        </div>
    </div>
</div>
            </div>
        </div>
    </div>
    <!-- Service End -->
        

    
