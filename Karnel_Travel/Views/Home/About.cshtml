@{
    // Set the browser page title
    ViewData["Title"] = "About Us";
}

@* Hero banner section *@
@section Hero {
<!-- Hero header container -->
<div class="container-fluid bg-primary py-5 mb-5 hero-header">
            <div class="container py-5">
                <div class="row justify-content-center py-5">
                    <div class="col-lg-10 pt-lg-5 mt-lg-5 text-center">
                        <h1 class="display-3 text-white animated slideInDown">About Us</h1>
                        <!-- Breadcrumb navigation -->
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb justify-content-center">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item text-white active" aria-current="page">About</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
}

    <!-- About Start -->
    <div class="container-fluid py-5">
        <div class="container">
            <div class="row g-5">
                <!-- Left column: about image -->
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s" style="min-height: 400px;">
                    <div class="position-relative h-100">
                        <img class="img-fluid position-absolute w-100 h-100" src="~/img/about.jpg" alt="" style="object-fit: cover;">
                    </div>
                </div>
                <!-- Right column: about text -->
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                    <h6 class="section-title bg-white text-start text-primary pe-3">About Us</h6>
                    <h1 class="mb-4">Welcome to <span class="text-primary">Karnel Travel Guide</span></h1>
                    <p class="mb-4">Karnel Travels is a tours and travel company that provides transportation between tourist spots and cities across the country, along with complete information about hotels, resorts and restaurants.</p>
                    <p class="mb-4">Through this website you can explore tourist spots, compare hotels and resorts by price and quality, check travel options, and contact us to place your tour or transport order.</p>
                    <!-- Feature checklist grid -->
                    <div class="row gy-2 gx-4 mb-4">
                        <div class="col-sm-6">
                           <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Transport to Tourist Spots</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Handpicked Hotels</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Comfortable Resorts</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Good Restaurants</p>
                        </div>
                        <div class="col-sm-6">
                             <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Tour Packages &amp; Discounts</p>
                        </div>
                        <div class="col-sm-6">
                           <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Customer Support</p>
                        </div>
                    </div>
                    <!-- Link to information page -->
                    <a class="btn btn-primary py-3 px-5 mt-2" asp-controller="Information" asp-action="Index">Explore Information</a>
                </div>
            </div>
        </div>
    </div>
    <!-- About End -->
        

    
